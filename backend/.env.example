# ---------- Server ----------
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# ---------- Security ----------
# Use a long random string (e.g. run: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=2h
FILE_LINK_EXPIRES_IN=5m
BCRYPT_ROUNDS=10

# ---------- Storage (everything stays on this machine) ----------
# SQLite database file and uploaded documents are stored under STORAGE_DIR
STORAGE_DIR=./storage
MAX_FILE_SIZE_MB=10
MAX_FILES_PER_UPLOAD=10
DOCUMENT_RETENTION_DAYS=365

# ---------- AI / LLM (xAI Grok) ----------
# LLM_PROVIDER=grok uses the Grok API. LLM_PROVIDER=mock uses a built-in offline
# rule-based extractor (useful for development without an API key).
LLM_PROVIDER=grok
GROK_API_KEY=
GROK_BASE_URL=https://api.x.ai/v1
GROK_MODEL=grok-4-1-fast-non-reasoning
LLM_TIMEOUT_MS=60000
LLM_MAX_INPUT_CHARS=12000

# ---------- OCR ----------
OCR_LANGUAGE=eng
OCR_LOW_CONFIDENCE=60
PDF_MIN_TEXT_CHARS_PER_PAGE=30
PDF_MAX_PAGES=10

# ---------- Background jobs ----------
JOB_CONCURRENCY=2
JOB_MAX_ATTEMPTS=4
JOB_POLL_INTERVAL_MS=1000
